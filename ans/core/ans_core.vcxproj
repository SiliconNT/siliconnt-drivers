<?xml version="1.0" encoding="utf-8"?>
<!--
  The core (this directory) as a kernel-mode static library, with the same toolset and
  options as the miniport (../ans.vcxproj): Release|ARM64, WindowsKernelModeDriver10.0,
  warning level 4, warnings as errors. ../../test.ps1 builds it to show the core compiles
  as Windows kernel code; the miniport compiles the same files into ans.sys.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E2B6C1F-4D7A-4F3B-A1E9-2C5D7B9F0A64}</ProjectGuid>
    <RootNamespace>ans_core</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <DriverType>Miniport</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="asc.c" />
    <ClCompile Include="nvme.c" />
    <ClCompile Include="pmgr.c" />
    <ClCompile Include="rtkit.c" />
    <ClCompile Include="sart.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="ans_core.h" />
    <ClInclude Include="ans_env.h" />
    <ClInclude Include="ans_internal.h" />
    <ClInclude Include="asc.h" />
    <ClInclude Include="nvme.h" />
    <ClInclude Include="pmgr.h" />
    <ClInclude Include="rtkit.h" />
    <ClInclude Include="sart.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
